{
  "appId": "uz.yuktop.app",
  "appName": "YUKTOP",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0D9488",
      "androidSplashResourceName": "splash",
